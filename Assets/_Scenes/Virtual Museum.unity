--- !u!102 &850619816
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 850619814}
  m_Text: "\u041B\u0435\u043E\u043D\u0430\u0440\u0434\u043E \u0434\u0438 \u0441\u0435\u0440
    \u041F\u044C\u0435\u0440\u043E \u0434\u0430 \u0412\u0438\u043D\u0447\u0438\r\n15.04.1452
    \u2013 2.05.1519\r\n\u0418\u0442\u0430\u043B\u044C\u044F\u043D\u0441\u043A\u0438\u0439
    \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A (\u0436\u0438\u0432\u043E\u043F\u0438\u0441\u0435\u0446,
    \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u043E\u0440, \n\u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440)
    \u0438 \u0443\u0447\u0451\u043D\u044B\u0439 (\u0430\u043D\u0430\u0442\u043E\u043C,
    \n\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u043E\u0438\u0441\u043F\u044B\u0442\u0430\u0442\u0435\u043B\u044C),
    \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043B\u044C, \u043F\u0438\u0441\u0430\u0442\u0435\u043B\u044C,
    \n\u043C\u0443\u0437\u044B\u043A\u0430\u043D\u0442, \u043E\u0434\u0438\u043D \u0438\u0437
    \u043A\u0440\u0443\u043F\u043D\u0435\u0439\u0448\u0438\u0445 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u0435\u0439
