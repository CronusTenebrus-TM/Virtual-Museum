--- !u!102 &526025503
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 526025502}
  m_Text: "\u0410\u0440\u0438\u0444\u043C\u043E\u043C\u0435\u0442\u0440 \u2014 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043D\u0430\u044F
    \r\n\u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \r\n\u043C\u0430\u0448\u0438\u043D\u0430, \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u0430\u044F
    \u0434\u043B\u044F \r\n\u0442\u043E\u0447\u043D\u043E\u0433\u043E \u0443\u043C\u043D\u043E\u0436\u0435\u043D\u0438\u044F
    \u0438 \u0434\u0435\u043B\u0435\u043D\u0438\u044F, \r\n\u0430 \u0442\u0430\u043A\u0436\u0435
    \u0434\u043B\u044F \u0441\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0438 \u0432\u044B\u0447\u0438\u0442\u0430\u043D\u0438\u044F.
    \ \r\n\u0427\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043E \u0430\u0440\u0438\u0444\u043C\u043E\u043C\u0435\u0442\u0440\u044B
    \u0431\u044B\u043B\u0438 \r\n\u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043D\u044B\u0435,
    \u0438\u0437\u0440\u0435\u0434\u043A\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B\u0438\u0441\u044C
    \r\n\u043A\u0430\u0440\u043C\u0430\u043D\u043D\u044B\u0435 \u043C\u043E\u0434\u0435\u043B\u0438.\r\n\u0410\u0440\u0438\u0444\u043C\u043E\u043C\u0435\u0442\u0440
    \u0412\u041A-1 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u043B\u0441\u044F
    \u0432 \r\n\u0433\u043E\u0440\u043E\u0434\u0435 \u041F\u0435\u043D\u0437\u0430
    \u043D\u0430 \u0437\u0430\u0432\u043E\u0434\u0435 \xAB\u0421\u0447\u0435\u0442\u043C\u0430\u0448\xBB
    \r\n\u0432 1950-1960-\u0445\u0445  \u0433\u043E\u0434\u0430\u0445.\r\n"
  m_OffsetZ: 0
  m_CharacterSize: 0.2
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 500
  m_FontStyle: 0
