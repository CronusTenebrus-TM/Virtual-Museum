--- !u!102 &758087872
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 758087870}
  m_Text: "\u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u0438\u0432\u043E\u043C
    \r\n\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F \r\n\xAB\u041B\u0435\u043D\u0438\u043D\u0433\u0440\u0430\u0434\u0441\u043A\u0438\u0439
    \r\n\u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0437\u0430\u0432\u043E\u0434\xBB. \r\n\u0412\u044B\u043F\u0443\u0441\u043A\u0430\u043B\u0441\u044F
    \u0441\u0435\u0440\u0438\u0439\u043D\u043E \n\u043D\u0430 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C
    \r\n\u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0438 (\u041F\u041E)
    \xAB\u0421\u0447\u0451\u0442\u043C\u0430\u0448\xBB \n\u041C\u0438\u043D\u043F\u0440\u0438\u0431\u043E\u0440\u0430,
    \r\u0433. \u041A\u0443\u0440\u0441\u043A. \n\u0413\u043B\u0430\u0432\u043D\u044B\u0439
    \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440 \r\n\u043C\u0430\u0448\u0438\u043D\u044B
    \u2014 \n\u0412\u0430\u043B\u0435\u043D\u0442\u0438\u043D \u0415\u0432\u0433\u0435\u043D\u044C\u0435\u0432\u0438\u0447
    \u041A\u0443\u0437\u043D\u0435\u0446\u043E\u0432.\r\n"
  m_OffsetZ: 0
  m_CharacterSize: 0.2
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 500
  m_FontStyle: 0
