--- !u!102 &173085565
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 173085563}
  m_Text: "\u0410\u0431\u0430\u043A \u2014 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u043E
    \u0441\u0447\u0451\u0442\u043D\u044B\u0445 \u0434\u043E\u0441\u043E\u043A, \r\n\u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0432\u0448\u0438\u0445\u0441\u044F
    \u0434\u043B\u044F \r\u0430\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \n\u0432\u044B\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u0439 \r\u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0441 V \u0432\u0435\u043A\u0430 \u0434\u043E \u043D. \u044D. \r\n\u0432 \u0434\u0440\u0435\u0432\u043D\u0438\u0445
    \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0430\u0445. \u041E\u0431\u0449\u0438\u0435
    \r\u043F\u0440\u0438\u043D\u0446\u0438\u043F\u044B \n\u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432
    \u0442\u0438\u043F\u0430 \r\u0430\u0431\u0430\u043A\u0430 \u2014 \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \n\u043B\u0438\u043D\u0438\u044F\u043C\u0438 \u043D\u0430 \r\u043F\u043E\u043B\u043E\u0441\u044B,
    \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u0435\u043D\u0438\u0435
    \u0441\u0447\u0451\u0442\u0430 \u0441 \r\n\u043F\u043E\u043C\u043E\u0449\u044C\u044E
    \u0440\u0430\u0437\u043C\u0435\u0449\u0451\u043D\u043D\u044B\u0445 \u043D\u0430
    \u043F\u043E\u043B\u043E\u0441\u0430\u0445 \r\u043A\u0430\u043C\u043D\u0435\u0439
    \n\u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0445
    \r\u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432. \u0421\u0440\u0435\u0434\u0438
    \n\u043F\u0440\u0438\u043C\u0435\u043D\u044F\u044E\u0449\u0438\u0445\u0441\u044F
    \r\u0432 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432 \n\u0430\u0431\u0430\u043A\u0430
    \u2014 \r\u0440\u0443\u0441\u0441\u043A\u0438\u0435 \u0441\u0447\u0451\u0442\u044B
    \u0438 \u044F\u043F\u043E\u043D\u0441\u043A\u0438\u0439 \u0441\u043E\u0440\u043E\u0431\u0430\u043D.\r\n"
  m_OffsetZ: 0
  m_CharacterSize: 0.2
  m_LineSpacing: 1.3
  m_Anchor: 0
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 500
  m_FontStyle: 0
  m_RichText: 1
