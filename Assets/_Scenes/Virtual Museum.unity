--- !u!102 &1627723972
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1627723970}
  m_Text: "\u041F\u0435\u0440\u0444\u043E\u043B\u0435\u043D\u0442\u0430 \u2014 \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C
    \r\n\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438 \u0432 \u0432\u0438\u0434\u0435
    \r\n\u0431\u0443\u043C\u0430\u0436\u043D\u043E\u0439 \u043B\u0435\u043D\u0442\u044B
    \u0441 \r\n\u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F\u043C\u0438.
    \u041F\u0435\u0440\u0432\u044B\u0435 \r\n\u043F\u0435\u0440\u0444\u043E\u043B\u0435\u043D\u0442\u044B
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438\u0441\u044C
    \r\n\u0441 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u044B XIX \u0432\u0435\u043A\u0430
    \u0432 \r\n\u0442\u0435\u043B\u0435\u0433\u0440\u0430\u0444\u0438\u0438, \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F
    \u0432 \u043D\u0438\u0445 \r\n\u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0438\u0441\u044C
    \u0432 5 \u0440\u044F\u0434\u043E\u0432, \r\n\u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0438
    \u0434\u0430\u043D\u043D\u044B\u0445 \r\n\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0441\u044F
    \u043A\u043E\u0434 \u0411\u043E\u0434\u043E.\r\n\u041F\u043E\u043B\u0443\u0447\u0438\u043B\u0430
    \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435
    \r\n\u0432 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043D\u043E\u0439
    \u0442\u0435\u0445\u043D\u0438\u043A\u0435.\r\n"
  m_OffsetZ: 0
  m_CharacterSize: 0.2
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 500
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 12800000, guid: 551da394d5c4fff49a7875b52926c7d5, type: 3}
  m_Color:
    serializedVersion: 2
    rgba: 4278190080
