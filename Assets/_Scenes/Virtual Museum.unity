--- !u!102 &51476278
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 51476276}
  m_Text: "\u0410\u0440\u0438\u0444\u043C\u043E\u043C\u0435\u0442\u0440 \u041E\u0434\u043D\u0435\u0440\u0430
    \u2014 \u0443\u0441\u043F\u0435\u0448\u043D\u0430\u044F \n\u0440\u0430\u0437\u043D\u043E\u0432\u0438\u0434\u043D\u043E\u0441\u0442\u044C
    \u0430\u0440\u0438\u0444\u043C\u043E\u043C\u0435\u0442\u0440\u043E\u0432, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u0430\u044F
    \n\u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u043C \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u043E\u043C
    \u0448\u0432\u0435\u0434\u0441\u043A\u043E\u0433\u043E \n\u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F
    \u0412. \u0422. \u041E\u0434\u043D\u0435\u0440\u043E\u043C.\r\r\n\u041F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E\u0435
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u0430\u0440\u0438\u0444\u043C\u043E\u043C\u0435\u0442\u0440\u0430
    \n\u0431\u044B\u043B\u043E \u043D\u0430\u043B\u0430\u0436\u0435\u043D\u043E \u0432
    \u0421\u0430\u043D\u043A\u0442-\u041F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0435
    \u0432 1890 \u0433\u043E\u0434\u0443. \n\u041E\u0434\u043D\u0435\u0440 \u0437\u0430\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u043B\u0441\u044F
    \u0430\u0440\u0438\u0444\u043C\u043E\u043C\u0435\u0442\u0440\u0430\u043C\u0438
    \u0432 \n1871 \u0433\u043E\u0434\u0443 \u043F\u043E\u0441\u043B\u0435 \u0440\u0435\u043C\u043E\u043D\u0442\u0430
    \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E \u043F\u043E\u043F\u0430\u0432\u0448\u0435\u0433\u043E
    \n\u043A \u043D\u0435\u043C\u0443 \u0430\u0440\u0438\u0444\u043C\u043E\u043C\u0435\u0442\u0440\u0430
    \u0422\u043E\u043C\u0430 \u0434\u0435 \u041A\u043E\u043B\u044C\u043C\u0430\u0440\u0430
    \u2014 \n\u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0441\u0435\u0440\u0438\u0439\u043D\u043E\u0433\u043E \u0430\u0440\u0438\u0444\u043C\u043E\u043C\u0435\u0442\u0440\u0430
    \u0442\u0435\u0445 \u043B\u0435\u0442. \n\u0423\u0436\u0435 \u0432 1873 \u0433\u043E\u0434\u0443
    \u0431\u044B\u043B \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D \u043F\u0435\u0440\u0432\u044B\u0439
    \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F, \n\u0430 \u0432 1877 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u044B
    14 \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u043E\u0432 \u043F\u043E
    \u0437\u0430\u043A\u0430\u0437\u0443 \n\u041B\u044E\u0434\u0432\u0438\u0433\u0430
    \u041D\u043E\u0431\u0435\u043B\u044F. \u0412 1878\u20141890 \u0433\u043E\u0434\u0430\u0445
    \u041E\u0434\u043D\u0435\u0440 \n\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u0438 \u0437\u0430\u043F\u0430\u0442\u0435\u043D\u0442\u043E\u0432\u0430\u043B
    \u0441\u0432\u043E\u044E \u043C\u0430\u0448\u0438\u043D\u0443."
  m_OffsetZ: 0
  m_CharacterSize: 0.2
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 500
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
  m_Color:
    serializedVersion: 2
    rgba: 4278190080
