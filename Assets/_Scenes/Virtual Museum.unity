--- !u!102 &1184096875
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1184096873}
  m_Text: "USB-\u0444\u043B\u0435\u0448-\u043D\u0430\u043A\u043E\u043F\u0438\u0442\u0435\u043B\u044C
    \u2014 \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0449\u0435\u0435
    \n\u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E, \u0444\u043B\u0435\u0448-\u043F\u0430\u043C\u044F\u0442\u044C,
    \u0438 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0430\u0435\u043C\u043E\u0435
    \n\u043A \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0443  \u043F\u043E
    \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0443 USB. \n\u0424\u043B\u044D\u0448-\u043D\u0430\u043A\u043E\u043F\u0438\u0442\u0435\u043B\u0438
    \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0441\u044A\u0451\u043C\u043D\u044B\u043C\u0438
    \u0438 \n\u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u043C\u044B\u043C\u0438,
    \u043C\u0430\u043B\u044B\u0445 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u0432,
    \n\u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0438\u043C\u0435\u044E\u0442 \u0432
    \u0442\u044B\u0441\u044F\u0447\u0438 \u0440\u0430\u0437 \u0431\u043E\u043B\u044C\u0448\u0435
    \n\u043C\u043E\u0449\u043D\u043E\u0441\u0442\u0438 \u0438 \u0431\u043E\u043B\u0435\u0435
    \u043F\u0440\u043E\u0447\u043D\u044B \u0438 \u043D\u0430\u0434\u0435\u0436\u043D\u044B,
    \n\u0447\u0435\u043C \u0433\u0438\u0431\u043A\u0438\u0435 \u0438 \u043A\u043E\u043C\u043F\u0430\u043A\u0442
    \u0434\u0438\u0441\u043A\u0438, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
    \u0443 \n\u043D\u0438\u0445 \u043D\u0435\u0442 \u0434\u0432\u0438\u0436\u0443\u0449\u0438\u0445\u0441\u044F
    \u0447\u0430\u0441\u0442\u0435\u0439. \u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E,
    \n\u043E\u043D\u0438 \u043D\u0435\u0432\u043E\u0441\u043F\u0440\u0438\u0438\u043C\u0447\u0438\u0432\u044B
    \u043A \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0438\u0442\u043D\u044B\u043C
    \n\u043F\u043E\u043C\u0435\u0445\u0430\u043C (\u0432 \u043E\u0442\u043B\u0438\u0447\u0438\u0435
    \u043E\u0442 \u0444\u043B\u043E\u043F\u043F\u0438-\u0434\u0438\u0441\u043A\u043E\u0432)
    \u0438 \n\u043D\u0435 \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0430\u044E\u0442\u0441\u044F
    \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044E \n\u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u044B\u0445
    \u0446\u0430\u0440\u0430\u043F\u0438\u043D."
