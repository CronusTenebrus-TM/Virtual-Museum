--- !u!102 &1287624064
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1287624062}
  m_Text: "\u0414\u0440\u0435\u0432\u043D\u0438\u0435 \u043B\u044E\u0434\u0438 \u043D\u0430
    \u0441\u043A\u0430\u043B\u0430\u0445 \n\u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0430\u043B\u0438
    \u0437\u0432\u0435\u0440\u0435\u0439, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u043E\u043D\u0438 \n\u043E\u0445\u043E\u0442\u0438\u043B\u0438\u0441\u044C. \u041E\u0434\u043D\u0430\u043A\u043E
    \u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0435, \n\u0433\u043B\u0438\u043D\u044F\u043D\u044B\u0435,
    \u043C\u0435\u043B\u043E\u0432\u044B\u0435 \u0440\u0438\u0441\u0443\u043D\u043A\u0438
    \n\u0441\u043C\u044B\u0432\u0430\u043B\u043E \u0434\u043E\u0436\u0434\u0451\u043C,
    \u0438 \u0434\u043B\u044F \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044F
    \n\u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u0438 \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438 \n\u043F\u0435\u0440\u0432\u043E\u0431\u044B\u0442\u043D\u044B\u0435
    \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0438 \u0441\u0442\u0430\u043B\u0438
    \n\u0432\u044B\u0431\u0438\u0432\u0430\u0442\u044C \u0441\u0438\u043B\u0443\u044D\u0442\u044B
    \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u043D\u0430 \n\u0441\u043A\u0430\u043B\u0430\u0445
    \u043E\u0441\u0442\u0440\u044B\u043C \u043A\u0430\u043C\u043D\u0435\u043C. \u0427\u0435\u043B\u043E\u0432\u0435\u043A
    \n\u043D\u0430\u0447\u0430\u043B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0434\u043B\u044F \u0437\u0430\u043F\u0438\u0441\u0438 \n\u0433\u043B\u0438\u043D\u0443,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0438\u043C\u0435\u043B\u0430 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430
    \n\u043A\u0430\u043C\u043D\u044F, \u0430 \u0435\u0451 \u043F\u043B\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u044C,
    \n\u0443\u0434\u043E\u0431\u0441\u0442\u0432\u043E \u0437\u0430\u043F\u0438\u0441\u0438
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u043B\u0438 \n\u043F\u043E\u0432\u044B\u0441\u0438\u0442\u044C
    \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C."
  m_OffsetZ: 0
  m_CharacterSize: 0.2
  m_LineSpacing: 1
