--- !u!102 &1704392835
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1704392833}
  m_Text: "\u041A\u043E\u043C\u043F\u0430\u043A\u0442-\u0434\u0438\u0441\u043A \u2014
    \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C
    \n\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438 \u0432 \u0432\u0438\u0434\u0435
    \u043F\u043B\u0430\u0441\u0442\u0438\u043A\u043E\u0432\u043E\u0433\u043E \u0434\u0438\u0441\u043A\u0430
    \u0441 \n\u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435\u043C \u0432 \u0446\u0435\u043D\u0442\u0440\u0435,
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u0437\u0430\u043F\u0438\u0441\u0438
    \u0438 \n\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043D\u0438\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \n\u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438 \u043B\u0430\u0437\u0435\u0440\u0430.
    \r\n\u0418\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E \u0431\u044B\u043B
    \u0441\u043E\u0437\u0434\u0430\u043D \u0434\u043B\u044F \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F
    \n\u0430\u0443\u0434\u0438\u043E\u0437\u0430\u043F\u0438\u0441\u0435\u0439, \u0432
    \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u043C \u0441\u0442\u0430\u043B
    \n\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u0434\u043B\u044F \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u043B\u044E\u0431\u044B\u0445
    \n\u0434\u0430\u043D\u043D\u044B\u0445. \u041F\u043E\u0437\u0436\u0435 \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C
    \n\u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u043C\u044B\u0435
    \u043A\u043E\u043C\u043F\u0430\u043A\u0442-\u0434\u0438\u0441\u043A\u0438.\r\n"
  m_OffsetZ: 0
  m_CharacterSize: 0.2
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 500
