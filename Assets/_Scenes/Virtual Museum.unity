--- !u!102 &1823435314
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1823435312}
  m_Text: "\u0410\u0440\u0438\u0444\u043C\u043E\u043C\u0435\u0442\u0440 \u041B\u0435\u0439\u0431\u043D\u0438\u0446\u0430
    \u2014 \u0430\u0440\u0438\u0444\u043C\u043E\u043C\u0435\u0442\u0440, \n\u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0451\u043D\u043D\u044B\u0439
    \u043D\u0435\u043C\u0435\u0446\u043A\u0438\u043C \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u043C
    \n\u0413\u043E\u0442\u0444\u0440\u0438\u0434\u043E\u043C \u0412\u0438\u043B\u044C\u0433\u0435\u043B\u044C\u043C\u043E\u043C
    \u041B\u0435\u0439\u0431\u043D\u0438\u0446\u0435\u043C. \u041F\u0435\u0440\u0432\u043E\u0435
    \n\u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0441\u0432\u043E\u0435\u0439
    \u043C\u0430\u0448\u0438\u043D\u044B \u041B\u0435\u0439\u0431\u043D\u0438\u0446
    \u0441\u0434\u0435\u043B\u0430\u043B \u0432 \n1670 \u0433\u043E\u0434\u0443. \u0412
    1673 \u0433\u043E\u0434\u0443 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B
    \n\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0435 \u0430\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u0438 \n\u043F\u0440\u043E\u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043B
    \u0435\u0433\u043E \u043D\u0430 \u0437\u0430\u0441\u0435\u0434\u0430\u043D\u0438\u0438
    \n\u041B\u043E\u043D\u0434\u043E\u043D\u0441\u043A\u043E\u0433\u043E \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0433\u043E
    \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430.\n\u0412 1674 \u2013 1676 \u0433\u043E\u0434\u0430\u0445
    \u041B\u0435\u0439\u0431\u043D\u0438\u0446 \u043F\u0440\u043E\u0432\u0435\u043B
    \u0431\u043E\u043B\u044C\u0448\u0443\u044E \n\u0440\u0430\u0431\u043E\u0442\u0443
    \u043F\u043E \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044E \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u044F
    \u0438 \u043F\u0440\u0438\u0432\u0435\u0437 \u0432 \n\u041B\u043E\u043D\u0434\u043E\u043D
    \u043D\u043E\u0432\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u043A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440\u0430.\n\u0412
    1694 \u0433\u043E\u0434\u0443 \u041B\u0435\u0439\u0431\u043D\u0438\u0446 \u0441\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u0438\u0440\u043E\u0432\u0430\u043B
    12 \n\u0440\u0430\u0437\u0440\u044F\u0434\u043D\u0443\u044E \u043C\u043E\u0434\u0435\u043B\u044C.\n\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
    \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u0431\u044B\u043B \u0441\u043E\u0437\u0434\u0430\u043D
    \u0432 1710 \u0433\u043E\u0434\u0443. "
  m_OffsetZ: 0
  m_CharacterSize: 0.2
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 500
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
  m_Color:
    serializedVersion: 2
    rgba: 4278190080
