--- !u!102 &554978314
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 554978312}
  m_Text: "\u0421\u0443\u043C\u043C\u0438\u0440\u0443\u044E\u0449\u0430\u044F \u043C\u0430\u0448\u0438\u043D\u0430
    \u041F\u0430\u0441\u043A\u0430\u043B\u044F \u2014 \u0430\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \n\u043C\u0430\u0448\u0438\u043D\u0430, \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0451\u043D\u043D\u0430\u044F
    \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438\u043C \u0443\u0447\u0451\u043D\u044B\u043C
    \u0411\u043B\u0435\u0437\u043E\u043C \n\u041F\u0430\u0441\u043A\u0430\u043B\u0435\u043C
    \u0432 1646 \u0433\u043E\u0434\u0443. \u0411\u043B\u0435\u0437 \u041F\u0430\u0441\u043A\u0430\u043B\u044C
    \u043D\u0430\u0447\u0430\u043B \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C
    \n\u0441\u0443\u043C\u043C\u0438\u0440\u0443\u044E\u0449\u0443\u044E \u043C\u0430\u0448\u0438\u043D\u0443
    \xAB\u041F\u0430\u0441\u043A\u0430\u043B\u0438\u043D\u0443\xBB \u0432 1642 \u0433\u043E\u0434\u0443,
    \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044F \n\u0437\u0430 \u0440\u0430\u0431\u043E\u0442\u043E\u0439
    \u0441\u0432\u043E\u0435\u0433\u043E \u043E\u0442\u0446\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0431\u044B\u043B \u0441\u0431\u043E\u0440\u0449\u0438\u043A\u043E\u043C \u043D\u0430\u043B\u043E\u0433\u043E\u0432
    \u0438 \n\u0447\u0430\u0441\u0442\u043E \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u043B
    \u0434\u043E\u043B\u0433\u0438\u0435 \u0438 \u0443\u0442\u043E\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0440\u0430\u0441\u0447\u0451\u0442\u044B. \r\n\u041C\u0430\u0448\u0438\u043D\u0430
    \u041F\u0430\u0441\u043A\u0430\u043B\u044F \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430
    \u0441\u043E\u0431\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \n\u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u0432 \u0432\u0438\u0434\u0435
    \u044F\u0449\u0438\u0447\u043A\u0430 \u0441 \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u043C\u0438
    \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u043C\u0438 \n\u043E\u0434\u043D\u0430
    \u0441 \u0434\u0440\u0443\u0433\u043E\u0439 \u0448\u0435\u0441\u0442\u0435\u0440\u0451\u043D\u043A\u0430\u043C\u0438.
    \u0421\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u043C\u044B\u0435 \u0447\u0438\u0441\u043B\u0430
    \n\u0432\u0432\u043E\u0434\u0438\u043B\u0438\u0441\u044C \u0432 \u043C\u0430\u0448\u0438\u043D\u0443
    \u043F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0433\u043E
    \n\u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430 \u043D\u0430\u0431\u043E\u0440\u043D\u044B\u0445
    \u043A\u043E\u043B\u0451\u0441\u0438\u043A\u043E\u0432. \u041F\u0440\u0438 \u0432\u0432\u043E\u0434\u0435
    \u0447\u0438\u0441\u043B\u0430 \u043A\u043E\u043B\u0435\u0441\u0438\u043A\u0438
    \n\u043F\u0440\u043E\u043A\u0440\u0443\u0447\u0438\u0432\u0430\u043B\u0438\u0441\u044C
    \u0434\u043E \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439
    \u0446\u0438\u0444\u0440\u044B.\r\n\u0417\u0430\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0439
    \u0432 \u043E\u0441\u043D\u043E\u0432\u0443 \xAB\u041F\u0430\u0441\u043A\u0430\u043B\u0438\u043D\u044B\xBB
    \u043F\u0440\u0438\u043D\u0446\u0438\u043F \n\u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0445
    \u043A\u043E\u043B\u0451\u0441 \u043F\u043E\u0447\u0442\u0438 \u043D\u0430 \u0442\u0440\u0438
    \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u044F \u0441\u0442\u0430\u043B \n\u043E\u0441\u043D\u043E\u0432\u043E\u0439
    \u0434\u043B\u044F \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0430
    \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0435\u043C\u044B\u0445 \n\u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432.\r\n"
  m_OffsetZ: 0
  m_CharacterSize: 0.2
  m_LineSpacing: 1
