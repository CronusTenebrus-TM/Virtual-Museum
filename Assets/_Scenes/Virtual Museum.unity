--- !u!102 &816553273
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 816553271}
  m_Text: "\xAB\u041F\u043E\u0438\u0441\u043A\xBB \u2014 16-\u0440\u0430\u0437\u0440\u044F\u0434\u043D\u044B\u0439
    \n\u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440,
    \n\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0439
    \u0441 \nIBM PC/XT. \u0412\u044B\u043F\u0443\u0441\u043A\u0430\u043B\u0441\u044F
    \u041A\u0438\u0435\u0432\u0441\u043A\u0438\u043C \n\u041D\u041F\u041E \xAB\u042D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043C\u0430\u0448\xBB.
    \u041E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0435 \n\u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438
    \u0438 \u0432\u044B\u043F\u0443\u0441\u043A \u043F\u0435\u0440\u0432\u043E\u0439
    \n\u0440\u0435\u0432\u0438\u0437\u0438\u0438 \u0434\u0430\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    1988 \u0433\u043E\u0434\u043E\u043C. \n\u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C\u0438 \n\u043F\u043E\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043B\u044F\u043C\u0438
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430 \u0441\u0442\u0430\u043B\u0438
    \n\u0443\u0447\u0435\u0431\u043D\u044B\u0435 \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u0421\u0421\u0421\u0420. \u0412 1991 \n\u0433\u043E\u0434\u0443 \u0431\u044B\u043B\u0430
    \u0432\u044B\u043F\u0443\u0449\u0435\u043D\u0430 \u0432\u0442\u043E\u0440\u0430\u044F,
    \n\u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0443\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \n\u0440\u0435\u0432\u0438\u0437\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0431\u044B\u043B\u0430 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0430
    \n\u0432 \u043F\u0435\u0440\u0432\u0443\u044E \u043E\u0447\u0435\u0440\u0435\u0434\u044C
    \u0434\u043B\u044F \u043C\u0430\u0441\u0441\u043E\u0432\u043E\u0439 \n\u043F\u0440\u043E\u0434\u0430\u0436\u0438.
    \u0421\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430
    \u0432 \n\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 1991 \u0433\u043E\u0434\u0430
    \u2014 1050 \u0440\u0443\u0431."
  m_OffsetZ: 0
  m_CharacterSize: 0.2
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 500
  m_FontStyle: 0
  m_RichText: 1
