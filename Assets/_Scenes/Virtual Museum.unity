--- !u!102 &803106499
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 803106497}
  m_Text: "\u041F\u0435\u0440\u0444\u043E\u043A\u0430\u0440\u0442\u0430 \u2014 \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438 \r\n\u0438\u0437
    \u0442\u043E\u043D\u043A\u043E\u0433\u043E \u043A\u0430\u0440\u0442\u043E\u043D\u0430,
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \r\n\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
    \u043D\u0430\u043B\u0438\u0447\u0438\u0435\u043C \u0438\u043B\u0438 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\u043C
    \r\n\u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0439 \u0432 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u0445
    \u043F\u043E\u0437\u0438\u0446\u0438\u044F\u0445 \r\n\u043A\u0430\u0440\u0442\u044B.
    \u041D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u0448\u0438\u0440\u043E\u043A\u043E
    \u043F\u0435\u0440\u0444\u043E\u043A\u0430\u0440\u0442\u044B \r\n\u043F\u0440\u0438\u043C\u0435\u043D\u044F\u043B\u0438\u0441\u044C
    \u0432\u043E \u0432\u0442\u043E\u0440\u043E\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435
    XX \r\n\u0432\u0435\u043A\u0430 \u0434\u043B\u044F \u0432\u0432\u043E\u0434\u0430
    \u0438 \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0434\u0430\u043D\u043D\u044B\u0445
    \u0432 \r\n\u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0445 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \r\n\u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438.\r\n\u0412\u043F\u0435\u0440\u0432\u044B\u0435
    \u0431\u044B\u043B\u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u044B
    \u0432 \r\n\xAB\u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043C\u0430\u0448\u0438\u043D\u0435\xBB \u0411\u044D\u0431\u0431\u0438\u0434\u0436\u0430\r\n"
  m_OffsetZ: 0
  m_CharacterSize: 0.2
  m_LineSpacing: 1
