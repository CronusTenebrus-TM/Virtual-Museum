--- !u!102 &1174563147
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1174563145}
  m_Text: "\u0422\u0430\u0431\u0443\u043B\u044F\u0442\u043E\u0440 \u2014 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043C\u0430\u0448\u0438\u043D\u0430, \n\u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u0430\u044F
    \u0434\u043B\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \n(\u0441\u0443\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u0438 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0437\u0430\u0446\u0438\u0438)
    \u0447\u0438\u0441\u043B\u043E\u0432\u043E\u0439 \u0438 \u0431\u0443\u043A\u0432\u0435\u043D\u043D\u043E\u0439
    \n\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438, \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u043E\u0439
    \u043D\u0430 \u043F\u0435\u0440\u0444\u043E\u043A\u0430\u0440\u0442\u0430\u0445,
    \u0441 \u0432\u044B\u0434\u0430\u0447\u0435\u0439 \n\u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432
    \u043D\u0430 \u0431\u0443\u043C\u0430\u0436\u043D\u0443\u044E \u043B\u0435\u043D\u0442\u0443
    \u0438\u043B\u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435
    \u0431\u043B\u0430\u043D\u043A\u0438. \n\u0412 80-\u044B\u0445 \u0433\u043E\u0434\u0430\u0445
    19 \u0432\u0435\u043A\u0430 \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0435\u0446
    \u0413\u0435\u0440\u043C\u0430\u043D \u0425\u043E\u043B\u043B\u0435\u0440\u0438\u0442
    \u0441\u043E\u0437\u0434\u0430\u043B \n\u043F\u0435\u0440\u0432\u044B\u0439 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0442\u0430\u0431\u0443\u043B\u044F\u0442\u043E\u0440. \u042D\u0442\u043E \u0431\u044B\u043B
    \n\u0441\u0447\u0451\u0442\u043D\u043E-\u0430\u043D\u0430\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u0434\u043B\u044F \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438
    \n\u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0434\u0430\u043D\u043D\u044B\u0445. \u042D\u0442\u043E  \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
    \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u043E \u0432 \n\u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0440\u0430\u0437 \u0443\u0441\u043A\u043E\u0440\u0438\u0442\u044C \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u044C
    \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F \u0432 \u0421\u0428\u0410,
    \u0438 \n\u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u043E\u0441\u044C
    \u0432\u043E \u043C\u043D\u043E\u0433\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0441\u0442\u0440\u0430\u043D\u0430\u0445 \n\u0434\u043B\u044F \u044D\u0442\u0438\u0445
    \u0446\u0435\u043B\u0435\u0439.  \u0418\u0437 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0435\u0439
    \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u0430 \u043C\u043E\u0436\u043D\u043E
    \n\u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432, \u0447\u0442\u043E \n\u044F\u0432\u043B\u044F\u043B\u043E\u0441\u044C
    \u0442\u043E\u0433\u0434\u0430 \u043F\u0435\u0440\u0435\u0434\u043E\u0432\u044B\u043C.
    \ \u0412\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0425\u043E\u043B\u043B\u0435\u0440\u0438\u0442
    \n\u0441\u043E\u0437\u0434\u0430\u043B \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044E
    \u043F\u043E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0443
    \u0442\u0430\u0431\u0443\u043B\u044F\u0442\u043E\u0440\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \n\u043F\u043E\u0437\u0436\u0435 \u043F\u043E\u0441\u043B\u0435 \u0440\u044F\u0434\u0430
    \u0441\u043B\u0438\u044F\u043D\u0438\u0439 \u0434\u0430\u043B\u0430 \u0436\u0438\u0437\u043D\u044C
    \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438 IBM."
