--- !u!102 &570389115
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 570389113}
  m_Text: "\u0413\u0435\u0440\u043C\u0430\u043D \u0425\u043E\u043B\u043B\u0435\u0440\u0438\u0442
    \r\n29.02.1860 \u2014 17.11.1929\r\n\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439
    \u0438\u043D\u0436\u0435\u043D\u0435\u0440 \u0438 \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043B\u044C
    \n\u043D\u0435\u043C\u0435\u0446\u043A\u043E\u0433\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F.\r
    \u0418\u0437\u0432\u0435\u0441\u0442\u0435\u043D \u043A\u0430\u043A \n\u0441\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u044C
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0442\u0430\u0431\u0443\u043B\u0438\u0440\u0443\u044E\u0449\u0435\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B.\r\n\u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
    \u043E\u0441\u043D\u043E\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u0438\u043A\u043E\u043C
    \n\u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E-\u043F\u0435\u0440\u0444\u043E\u0440\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439
    \u0442\u0435\u0445\u043D\u0438\u043A\u0438, \n\u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043F\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u0446\u0435\u0439
    \n\u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043E\u0432.
    \u0418\u0437\u043E\u0431\u0440\u0451\u043B \u043F\u0435\u0440\u0444\u043E\u043A\u0430\u0440\u0442\u0443,
    \n\u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0430\u0441\u044C
    \u043F\u043E\u0447\u0442\u0438 \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u0435."
  m_OffsetZ: 0
  m_CharacterSize: 0.2
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 400
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 12800000, guid: 551da394d5c4fff49a7875b52926c7d5, type: 3}
  m_Color:
    serializedVersion: 2
    rgba: 4278190080
