--- !u!102 &1455939161
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1455939159}
  m_Text: "\u0413\u043E\u0442\u0444\u0440\u0438\u0434 \u0412\u0438\u043B\u044C\u0433\u0435\u043B\u044C\u043C
    \u041B\u0435\u0439\u0431\u043D\u0438\u0446\n21.06.1646 \u2014 14.11.1716\n\u0421\u0430\u043A\u0441\u043E\u043D\u0441\u043A\u0438\u0439
    \u0444\u0438\u043B\u043E\u0441\u043E\u0444, \u043B\u043E\u0433\u0438\u043A, \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A,
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A, \u0444\u0438\u0437\u0438\u043A, \n\u044E\u0440\u0438\u0441\u0442,
    \u0438\u0441\u0442\u043E\u0440\u0438\u043A, \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442,
    \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043B\u044C \u0438
    \u044F\u0437\u044B\u043A\u043E\u0432\u0435\u0434.\n\u0412\u0430\u0436\u043D\u0435\u0439\u0448\u0438\u0435
    \u043D\u0430\u0443\u0447\u043D\u044B\u0435 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F:\r\n\u2022
    \u041B\u0435\u0439\u0431\u043D\u0438\u0446 \u0441\u043E\u0437\u0434\u0430\u043B
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0430\u043D\u0430\u043B\u0438\u0437 \u2014 \n\u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435
    \u0438 \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u043B\u044C\u043D\u043E\u0435
    \u0438\u0441\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u044F, \n\u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u043D\u0430 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E \u043C\u0430\u043B\u044B\u0445.\r\n\u2022
    \u041B\u0435\u0439\u0431\u043D\u0438\u0446 \u0441\u043E\u0437\u0434\u0430\u043B
    \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0442\u043E\u0440\u0438\u043A\u0443
    \u043A\u0430\u043A \u043D\u0430\u0443\u043A\u0443.\r\n\u2022 \u041E\u043D \u0437\u0430\u043B\u043E\u0436\u0438\u043B
    \u043E\u0441\u043D\u043E\u0432\u044B \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043B\u043E\u0433\u0438\u043A\u0438. \r\n\u2022 \u041E\u043F\u0438\u0441\u0430\u043B
    \u0434\u0432\u043E\u0438\u0447\u043D\u0443\u044E \u0441\u0438\u0441\u0442\u0435\u043C\u0443
    \u0441\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u044F \u0441 \u0446\u0438\u0444\u0440\u0430\u043C\u0438
    0 \u0438 1.\r\n\u2022 \u0412 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0435
    \u0432\u0432\u0451\u043B \u043F\u043E\u043D\u044F\u0442\u0438\u0435 \xAB\u0436\u0438\u0432\u043E\u0439
    \u0441\u0438\u043B\u044B\xBB \u0438 \u0441\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043B
    \n\u0437\u0430\u043A\u043E\u043D \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F
    \u044D\u043D\u0435\u0440\u0433\u0438\u0438.\r\n"
  m_OffsetZ: 0
  m_CharacterSize: 0.2
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 1
  m_TabSize: 4
