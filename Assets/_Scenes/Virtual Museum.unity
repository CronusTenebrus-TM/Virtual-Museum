--- !u!102 &1898850764
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1898850762}
  m_Text: "Colossus (\xAB\u041A\u043E\u043B\u043E\u0441\u0441\xBB) \u2014 \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u044B\u0439
    \u0431\u0440\u0438\u0442\u0430\u043D\u0441\u043A\u0438\u0439 \n\u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440,
    \u0441\u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0438 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0439 \n\u0432
    1943 \u0433\u043E\u0434\u0443 \u0434\u043B\u044F \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0438
    \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0447\u0435\u043D\u043D\u044B\u0445
    \n\u043D\u0435\u043C\u0435\u0446\u043A\u0438\u0445 \u0440\u0430\u0434\u0438\u043E\u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0439,
    \u0437\u0430\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \n\u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0441\u0438\u0441\u0442\u0435\u043C\u044B
    Lorenz SZ. \u041A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440 \n\u0441\u043E\u0441\u0442\u043E\u044F\u043B
    \u0438\u0437 1500 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u044B\u0445
    \u043B\u0430\u043C\u043F (2500 \u0432 \nColossus Mark II), \u0447\u0442\u043E
    \u0434\u0435\u043B\u0430\u043B\u043E Colossus \u0441\u0430\u043C\u044B\u043C \n\u0431\u043E\u043B\u044C\u0448\u0438\u043C
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043E\u043C \u0442\u043E\u0433\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438. \n\u0421\u043E\u0437\u0434\u0430\u043D\u0438\u0435
    \u0438 \u0432\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0432 \u0441\u0442\u0440\u043E\u0439
    \u0432 1944 \u0433\u043E\u0434\u0443 \n\u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u043E
    \u0441\u043E\u043A\u0440\u0430\u0442\u0438\u0442\u044C \u0432\u0440\u0435\u043C\u044F
    \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0438 \n\u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0447\u0435\u043D\u043D\u044B\u0445
    \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0439 \u0441 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
    \n\u043D\u0435\u0434\u0435\u043B\u044C \u0434\u043E \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
    \u0447\u0430\u0441\u043E\u0432. \u041C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0430\u0446\u0438\u044F
    \nColossus Mark II \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043F\u0435\u0440\u0432\u044B\u043C
    \n\u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u0443\u0435\u043C\u044B\u043C
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043E\u043C \u0432 \n\u0438\u0441\u0442\u043E\u0440\u0438\u0438
    \u042D\u0412\u041C."
  m_OffsetZ: 0
  m_CharacterSize: 0.2
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 400
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
  m_Color:
    serializedVersion: 2
    rgba: 4278190080
