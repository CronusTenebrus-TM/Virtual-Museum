--- !u!102 &2047194595
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 2047194593}
  m_Text: "\u0414\u0438\u0441\u043A\u0435\u0442\u0430 \u2014 \u0441\u043C\u0435\u043D\u043D\u044B\u0439
    \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C \n\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438,
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0439 \n\u0434\u043B\u044F
    \u043C\u043D\u043E\u0433\u043E\u043A\u0440\u0430\u0442\u043D\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u0438
    \u0438 \n\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0434\u0430\u043D\u043D\u044B\u0445.
    \n\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439
    \n\u043F\u043E\u043C\u0435\u0449\u0451\u043D\u043D\u044B\u0439 \u0432 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0439
    \n\u043F\u043B\u0430\u0441\u0442\u0438\u043A\u043E\u0432\u044B\u0439 \u043A\u043E\u0440\u043F\u0443\u0441
    \u0434\u0438\u0441\u043A, \n\u043F\u043E\u043A\u0440\u044B\u0442\u044B\u0439 \u0444\u0435\u0440\u0440\u043E\u043C\u0430\u0433\u043D\u0438\u0442\u043D\u044B\u043C
    \n\u0441\u043B\u043E\u0435\u043C.\r \u0411\u044B\u043B\u0438 \u043C\u0430\u0441\u0441\u043E\u0432\u043E
    \n\u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u044B
    \u0441 1970-\u0445 \u0438 \n\u0434\u043E \u043A\u043E\u043D\u0446\u0430 1990-\u0445
    \u0433\u043E\u0434\u043E\u0432, \n\u043F\u0440\u0438\u0434\u044F \u043D\u0430
    \u0441\u043C\u0435\u043D\u0443 \u043F\u0435\u0440\u0444\u043E\u043A\u0430\u0440\u0442\u0430\u043C\r\n"
  m_OffsetZ: 0
  m_CharacterSize: 0.2
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 500
